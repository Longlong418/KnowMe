# BEGIN GENERATED CONNECTIONS
# Generated by scripts/generate_env_example.py; definitions live in knowme/integrations.py


# ── AI Providers ──

# ── Anthropic ──
# Uses Anthropic models.
# ANTHROPIC_API_KEY=

# ── Openai ──
# Uses Openai models.
# OPENAI_API_KEY=

# ── Openrouter ──
# Uses Openrouter models.
# OPENROUTER_API_KEY=

# ── Gemini ──
# Uses Gemini models.
# GEMINI_API_KEY=

# ── Deepseek ──
# Uses Deepseek models.
# DEEPSEEK_API_KEY=

# ── Minimax ──
# Uses Minimax models.
# MINIMAX_API_KEY=
# Choices: https://api.minimaxi.com/anthropic, https://api.minimax.io/anthropic.
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ── Kimi ──
# Uses Kimi models.
# MOONSHOT_API_KEY=
# Choices: https://api.moonshot.ai/anthropic, https://api.moonshot.cn/anthropic.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/anthropic

# ── Glm ──
# Uses Glm models.
# ZHIPU_API_KEY=
# Choices: https://api.z.ai/api/anthropic, https://open.bigmodel.cn/api/anthropic.
# ZHIPU_BASE_URL=https://api.z.ai/api/anthropic

# ── Xai ──
# Uses Xai models.
# XAI_API_KEY=

# ── Opencode Zen ──
# Uses Opencode Zen models.
# OPENCODE_ZEN_API_KEY=

# ── Opencode Go ──
# Uses Opencode Go models.
# OPENCODE_GO_API_KEY=

# ── Channels ──

# ── Telegram ──
# Lets KnowMe receive and send Telegram messages.
# Install: pip install -e '.[telegram]'
# Setup: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER=

# ── Discord ──
# Lets KnowMe answer in a Discord server.
# Install: pip install -e '.[discord]'
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER=
# DISCORD_ALLOWED_CHANNEL=
# Set to 1 to enable.
# DISCORD_REQUIRE_MENTION=
# DISCORD_MAX_TURNS_PER_HOUR=
# DISCORD_HOME=

# ── WhatsApp ──
# Lets KnowMe answer WhatsApp messages via the Meta Cloud API.
# Install: pip install -e '.[whatsapp]'
# Setup: https://developers.facebook.com/apps
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Without '+' prefix. Empty = answer anyone.
# WHATSAPP_ALLOWED_PHONE=

# ── Calendar & Productivity ──

# ── Google Calendar ──
# Lets KnowMe create and update Google Calendar events.
# Install: pip install -e '.[gcal]'
# Setup: https://developers.google.com/calendar/api/quickstart/python
# Set to 1 to enable.
# KNOWME_GOOGLE_CALENDAR=
# KNOWME_GOOGLE_CALENDAR_ID=primary

# ── Apple Calendar ──
# Lets KnowMe work with Apple Calendar on this Mac.
# Set to 1 to enable.
# KNOWME_APPLE_CALENDAR=
# KNOWME_APPLE_CALENDARS=

# ── Apple Tools ──
# Lets KnowMe use Apple Mail and other local Apple tools.
# Set to 1 to enable.
# KNOWME_APPLE_TOOLS=

# ── Memory & Storage ──

# ── Notion ──
# Stores episodic memory in a Notion database.
# Install: pip install -e '.[notion]'
# Setup: https://www.notion.so/my-integrations
# Choices: sqlite, notion.
# KNOWME_EPISODIC_STORE=sqlite
# NOTION_TOKEN=
# NOTION_EPISODES_DATABASE_ID=

# ── Mem0 ──
# Stores semantic memory in the Mem0 service.
# Install: pip install -e '.[arena]'
# Choices: sqlite, mem0.
# KNOWME_SEMANTIC_STORE=sqlite
# From app.mem0.ai. The adapter sends infer=False so add() always stores — a bake-off against it measures retrieval, not Mem0's own extraction step.
# MEM0_API_KEY=
# Defaults to 'knowme'. Change it only if several people share one Mem0 account.
# MEM0_USER_ID=

# ── Zep ──
# Stores semantic memory in a Zep temporal graph.
# Install: pip install -e '.[arena]'
# Choices: sqlite, zep.
# KNOWME_SEMANTIC_STORE=sqlite
# From getzep.com. Facts become graph edges with validity dates, so a correction supersedes the old value instead of ranking beside it — the one backend built for the update test.
# ZEP_API_KEY=
# Defaults to 'knowme'. Zep scopes a graph per user.
# ZEP_USER_ID=
# Ingestion is asynchronous: graph.add returns in ~0.2s with the episode unprocessed, and the text is not searchable until Zep has turned it into nodes and edges. KnowMe polls until it has, up to this long. Default 120 — raise it if seeding times out, never lower it to make a benchmark finish.
# ZEP_MAX_WAIT_SECONDS=

# ── LangMem ──
# Stores semantic memory in a LangGraph store via LangMem.
# Install: pip install -e '.[arena]'
# Choices: sqlite, langmem.
# KNOWME_SEMANTIC_STORE=sqlite
# Optional. Without it LangGraph's InMemoryStore is used, which its own docs describe as a reference implementation whose data dies with the process — fine for a benchmark run, not a persistence story.
# KNOWME_LANGMEM_POSTGRES=
# LangMem has no key of its own; it bills through embeddings. Semantic search needs this or the store is a plain key-value dict.
# OPENAI_API_KEY=

# ── Supabase ──
# Stores semantic memory in Supabase pgvector.
# Install: pip install -e '.[supabase]'
# Choices: sqlite, supabase.
# KNOWME_SEMANTIC_STORE=sqlite
# SUPABASE_URL=
# Embeddings also require OPENAI_API_KEY (optionally OPENAI_EMBED_MODEL).
# SUPABASE_SERVICE_KEY=

# ── Search & Observability ──

# ── Tavily ──
# Lets KnowMe search the web.
# Setup: https://tavily.com
# TAVILY_API_KEY=

# ── OpenTelemetry ──
# Exports traces to an OTLP collector.
# Install: pip install -e '.[tracing]'
# OTEL_EXPORTER_OTLP_ENDPOINT=

# END GENERATED CONNECTIONS

# ── Models (optional) ───────────────────────────────────────────────────────
# Each provider has sensible defaults (see knowme/loop/models.py PROVIDERS):
#   anthropic:  claude-sonnet-5              + claude-haiku-4-5 (gate/summarizer)
#   openai:     gpt-5.5                      + gpt-4.1-mini
#   gemini:     gemini-3.5-flash             + gemini-3.1-flash-lite
#   deepseek:   deepseek-v4-pro              + deepseek-v4-pro
#   minimax:    MiniMax-M3                   + MiniMax-M2
#   kimi:       kimi-k3                      + kimi-k2.6 (gate/summarizer)
#               (K3-only key? set KNOWME_SMALL_MODEL=kimi-k3 too)
#   glm:        glm-5.2                      + glm-5-turbo
#   openrouter: nemotron-3-super:free        + gemma-4-26b:free (both $0,
#               rate-limited; Settings lists the live catalog, free first)
# openrouter's whole point is picking a different model, so KNOWME_MODEL takes
# any "<vendor>/<model>" slug from https://openrouter.ai/models — e.g.
# KNOWME_MODEL=meta-llama/llama-3.1-70b-instruct
# Override here if you want something else — they're just strings:
# KNOWME_MODEL=
# KNOWME_SMALL_MODEL=
# ...and KNOWME_SMALL_MODEL is now the FALLBACK for the two roles below, not a
# model the gate and the summariser are stuck with.
#
# Two side jobs may each run somewhere else entirely: the retrieval gate ("does
# this turn need memory at all?") and the summariser (long conversations, and
# distilling chats into long-term facts). Pick them on the Models page
# (角色模型), or here. An empty provider follows KNOWME_PROVIDER; an empty model
# follows that provider's own cheap default. All four empty = one provider for
# everything, which is exactly how it worked before.
# KNOWME_GATE_PROVIDER=deepseek
# KNOWME_GATE_MODEL=
# KNOWME_SUMMARY_PROVIDER=
# KNOWME_SUMMARY_MODEL=gpt-4.1-mini
# Advanced: point at any compatible endpoint / bring your own key var:
# KNOWME_BASE_URL=
# KNOWME_API_KEY=

# ── KnowMe home (optional) ──────────────────────────────────────────────────
# Where memory (state.db), calendar.ics, outbox/ and traces/ live.
# KNOWME_HOME=.knowme

# ── Loop guardrails (optional) ──────────────────────────────────────────────
# KNOWME_MAX_ITERATIONS=10
# KNOWME_MAX_TOKENS=2048
# Working memory bound. Over KNOWME_SNIP_HEAD + 1 + KNOWME_SNIP_TAIL messages the
# middle of the conversation is archived to .knowme/archives/ and a marker takes
# its place, so nothing is dropped silently and the opening survives. One snip
# buys KNOWME_SNIP_TAIL messages of room. (KNOWME_HISTORY_TURNS was removed with
# the sliding window it configured — see config.py.)
# KNOWME_SNIP_HEAD=3
# KNOWME_SNIP_TAIL=46

# ── Tool-result compression (optional) ──────────────────────────────────────
# A tool result is re-sent on every later turn (it rides in the [tools used: ...]
# line), so a long one is paid for over and over. Tool output too big to keep is
# written in full to .knowme/tool_results/ and replaced in history by an excerpt
# plus a pointer, which the agent can read back with the read_tool_result tool.
# Two separate knobs: the budget decides WHETHER a turn is compressed at all (a
# small turn is left byte-for-byte alone), the cap decides how small a compressed
# result gets (anything already under it is never touched). The cap is the whole
# digest — pointer and elision marker included — so a compressed result is never
# longer than the cap, and never longer than what it replaced.
# KNOWME_TOOL_RESULT_BUDGET=4000
# KNOWME_TOOL_RESULT_CAP=1200

# ── Emergency context valve (optional) ──────────────────────────────────────
# micro_compact runs LAST of the three compressors and is the only one that
# measures the assembled prompt against the model's real context window. Past
# KNOWME_CONTEXT_TRIGGER of that window, every tool result older than the newest
# KNOWME_MICRO_KEEP ones — and longer than KNOWME_MICRO_MIN_CHARS — is written to
# .knowme/tool_results/ and replaced in the conversation by its path alone. It
# keeps no excerpt: it is the valve you open when the alternative is a request
# that does not fit.
# KNOWME_CONTEXT_TRIGGER=0.8
# KNOWME_MICRO_KEEP=3
# KNOWME_MICRO_MIN_CHARS=120
# Context window for a model the built-in table does not know. The live catalog
# wins over this where the endpoint publishes one (OpenRouter does).
# KNOWME_MODEL_CONTEXT=
# If the prompt is STILL over the trigger after every reversible compressor has
# run, the conversation is summarised and replaced by a single [Compacted]
# message. This is the only lossy step — the summary is all the model keeps, so
# it runs on the small model and the prompt that produces it is where the safety
# margin lives. The complete transcript is written to .knowme/archives/ either way.
# KNOWME_SUMMARY_MAX_TOKENS=4096

# ── Memory tuning (optional) ────────────────────────────────────────────────
# Consolidate chats into durable facts only after N new exchanges.
# KNOWME_CONSOLIDATE_EVERY=6
# KNOWME_RETRIEVAL_TOP_K=4

# ── GitHub, read-only (optional) ────────────────────────────────────────────
# Lets the agent read pull requests and issues through the `gh` CLI. There is
# no token here: gh keeps its own credentials, so run `gh auth login` once and
# nothing sensitive lands in this file. The tool is READ-ONLY by construction —
# it can list/view PRs and issues and read a diff, and refuses to merge,
# comment, close or push. Off by default because every registered tool ships in
# every prompt, and this is maintainer capability, not assistant capability.
# KNOWME_GH_TOOL=1
# Repo to assume when a call omits one (for running outside a checkout):
# KNOWME_GH_REPO=your-org/knowme-agent

# ── Open files in your editor (optional) ────────────────────────────────────
# Dashboard "reveal" links open files in this editor when it's on PATH
# (falls back to cursor, then code, then Finder):
# KNOWME_EDITOR=cursor

# ── Experimental tools (optional) ───────────────────────────────────────────
# delegate_task (LIVE): hand coding jobs to pi, the open-source coding agent —
#   npm install -g --ignore-scripts @earendil-works/pi-coding-agent
# The terminal/browser/cron skeletons still just report "coming soon".
# KNOWME_EXPERIMENTAL=1
# Graph workflows: triage every message through a graph (small-model classify +
# calendar peek in parallel -> quick reply, or the normal loop as a node).
# Fails open to the plain loop on any error. See knowme/graph/.
# KNOWME_GRAPH_WORKFLOWS=1
# Max seconds pi may spend on one delegated task (default 300):
# KNOWME_DELEGATE_TIMEOUT=300

# ── MCP servers (optional): pip install -e '.[mcp]' ─────────────────────────
# Connect Model Context Protocol servers by creating .knowme/mcp.json:
#   {"servers": [{"name": "fs", "command": "npx",
#                 "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}]}
# Their tools register as <server>_<tool> and appear to the agent automatically.

# ── Voice gateway (optional): pip install -e '.[voice]' ────────────────────
# Unset = push-to-talk (Enter, speak, Enter). Set a wake word — ANY phrase —
# and `make voice` becomes always-listening:
# KNOWME_WAKE_WORD=knowme knowme
# What it says when it wakes:
# KNOWME_WAKE_ACK=Yes?
# Stay in the conversation after answering (Siri-style) for N seconds before
# needing "knowme knowme" again:
# KNOWME_FOLLOWUP_SECONDS=8
# STT model (tiny/base/small — bigger = more accurate, slower):
# KNOWME_WHISPER_MODEL=base
# TTS engine: 'say' (macOS built-in, default) or 'kokoro' (neural British
# butler — first: pip install kokoro soundfile):
# KNOWME_TTS=say
# KNOWME_VOICE=Daniel
# (for kokoro use voices like bm_george / bm_fable)
# Mic sensitivity: lower if it never hears you, higher if it wakes on noise:
# KNOWME_MIC_THRESHOLD=0.005

# ── Reliability (optional) ──────────────────────────────────────────────────
# Max seconds any single LLM call may take before erroring instead of hanging:
# KNOWME_LLM_TIMEOUT=120
